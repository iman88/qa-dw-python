# Postgres started by docker compose (host port 55432 to avoid clashing with a local 5432)
DB_URL=postgresql+psycopg://qa:qa@localhost:55432/clinical

# Synthetic data size and seed. Same seed = same data, so failures reproduce.
DATA_SEED=42
SUBJECTS_PER_STUDY=40

# GenAI engine for the narrative service: "template" (offline, default) or "claude".
# With claude, GENAI_FALLBACK=on (default) answers from the template whenever Claude cannot;
# set GENAI_FALLBACK=off to evaluate Claude strictly (a failure then fails the test).
GENAI_PROVIDER=template
GENAI_FALLBACK=on
CLAUDE_MODEL=claude-opus-5-5
# Claude credentials: ANTHROPIC_API_KEY, or a profile from `ant auth login`
